# Copy to .env. Leave LLM_MODEL empty to disable OCR.
LLM_MODEL=
# LLM_MODEL=openai:gpt-4.1-mini
# Fallback example: openai:gpt-4.1-mini,anthropic:claude-sonnet-4-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Bedrock uses standard AWS credentials/region or AWS_BEARER_TOKEN_BEDROCK.
LLM_PDF_INPUT=false
LLM_BATCH_SIZE=5
LLM_CONCURRENCY=8

# Each scraper writes NAME/documents.db and YEAR/docs/ below its root.
SAVE_DIR=outputs/legislation
# STATE_LEGISLATION_SAVE_DIR=outputs/states
# SPECIFIC_LEGISLATION_SAVE_DIR=outputs/environment
LOG_DIR=logs/legislation

# Optional proxy list sources.
# PROXY_FILE_PATH=proxies.txt
# PROXY_ENDPOINT=https://example.org/proxies
